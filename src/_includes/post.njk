---
layout: base.njk
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ (description or site.description) | dump | safe }},
  "datePublished": "{{ date | htmlDateString }}",
  "author": { "@type": "Organization", "name": {{ site.author | dump | safe }} },
  "publisher": { "@type": "Organization", "name": {{ site.name | dump | safe }} },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ site.domain }}{{ page.url | url }}" }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ site.name | dump | safe }}, "item": "{{ site.domain }}{{ '/' | url }}" },
    { "@type": "ListItem", "position": 2, "name": {{ title | dump | safe }}, "item": "{{ site.domain }}{{ page.url | url }}" }
  ]
}
</script>
<article>
  <div class="post-card-meta">
    {% if category %}<span class="category-pill">{{ category }}</span>{% endif %}
    <span class="post-meta">Published {{ date | readableDate }} · {{ content | readingTime }}</span>
  </div>
  <h1>{{ title }}</h1>
  <div class="affiliate-note">This post contains affiliate links. If you buy through them, we may earn a commission at no extra cost to you. See our <a href="{{ '/affiliate-disclosure/' | url }}">affiliate disclosure</a>.</div>
  {{ content | safe }}
</article>
<aside class="related-posts">
  <h2>Related Reading</h2>
  <ul>
    {% for post in collections.posts %}
      {% if post.url != page.url %}
        <li><a href="{{ post.url | url }}">{{ post.data.title }}</a></li>
      {% endif %}
    {% endfor %}
  </ul>
</aside>
