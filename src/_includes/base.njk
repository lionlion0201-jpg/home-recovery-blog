<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} | {{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.domain }}{{ page.url | url }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.domain }}{{ page.url | url }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
</head>
<body>
<header class="site-header">
  <a class="brand" href="{{ '/' | url }}">{{ site.name }}</a>
  <nav>
    <a href="{{ '/' | url }}">Home</a>
    <a href="{{ '/about/' | url }}">About</a>
    <a href="{{ '/affiliate-disclosure/' | url }}">Disclosure</a>
  </nav>
</header>
<main>
{{ content | safe }}
</main>
<footer class="site-footer">
  <p>&copy; {{ currentYear }} {{ site.name }}. All rights reserved.</p>
  <p><a href="{{ '/affiliate-disclosure/' | url }}">Affiliate Disclosure</a> · <a href="{{ '/privacy-policy/' | url }}">Privacy Policy</a></p>
</footer>
</body>
</html>
