<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} | {{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.domain }}{{ page.url | url }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.domain }}{{ page.url | url }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
{% if site.googleSiteVerification %}<meta name="google-site-verification" content="{{ site.googleSiteVerification }}">{% endif %}
{% if site.gaId %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}"></script>
<script>
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '{{ site.gaId }}');
</script>
{% endif %}
</head>
<body>
<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="{{ '/' | url }}">{{ site.name }}</a>
    <nav>
      <a href="{{ '/' | url }}">Home</a>
      <a href="{{ '/about/' | url }}">About</a>
      <a href="{{ '/affiliate-disclosure/' | url }}">Disclosure</a>
    </nav>
  </div>
</header>
<main>
{{ content | safe }}
</main>
<footer class="site-footer">
  <p class="tagline">Recover better. Sleep better. Spend smarter.</p>
  <p>&copy; {{ currentYear }} {{ site.name }}. All rights reserved.</p>
  <p><a href="{{ '/affiliate-disclosure/' | url }}">Affiliate Disclosure</a> · <a href="{{ '/privacy-policy/' | url }}">Privacy Policy</a></p>
</footer>
</body>
</html>
