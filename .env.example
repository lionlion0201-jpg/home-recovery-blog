# Pinterest API v5 (https://developers.pinterest.com)
PINTEREST_ACCESS_TOKEN=
PINTEREST_DEFAULT_BOARD_ID=

# X (Twitter) API v2 -- OAuth 1.0a user context, required for posting
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Safety limit: max posts a single script run is allowed to make (cost control for X pay-per-use)
MAX_POSTS_PER_RUN=6
