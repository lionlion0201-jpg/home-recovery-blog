# Pinterest API v5 (https://developers.pinterest.com)

# 投稿用。スコープ: pins:write / boards:read / boards:write
# ピン投稿(pinterest-backlog.yml)で使う。
PINTEREST_ACCESS_TOKEN=
PINTEREST_DEFAULT_BOARD_ID=

# 計測用(読み取り専用)。スコープ: pins:read / boards:read / user_accounts:read など
# Developer Portal の「アクセストークンを生成する」(本番環境を選択)で発行する。
#
# 投稿用と分けている理由:
#   - 毎日稼働中のピン投稿のトークンを触らずに済む
#   - 計測処理に書き込み権限を渡さずに済む
# 上の PINTEREST_ACCESS_TOKEN をこちらで上書きしないこと(pins:write が無く投稿が止まる)。
PINTEREST_READ_TOKEN=

# X (Twitter) API v2 -- OAuth 1.0a user context, required for posting
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# 自分の数値ユーザーID(任意)。
# メトリクス取得時、未設定だと毎回 GET /2/users/me を呼んで約$0.01かかる。
# GitHub Actions では Settings → Secrets and variables → Actions → Variables に
# X_USER_ID として登録しておくと節約できる(秘密情報ではない)。
X_USER_ID=

# Safety limit: max posts a single script run is allowed to make (cost control for X pay-per-use)
MAX_POSTS_PER_RUN=6
